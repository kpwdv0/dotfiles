alt - j : yabai -m window --focus south || yabai -m display --focus south
alt - k : yabai -m window --focus north || yabai -m display --focus north
alt - l : yabai -m window --focus east  || yabai -m display --focus east

shift + alt - h : yabai -m window --warp west  || yabai -m window --display west  || true
shift + alt - j : yabai -m window --warp south || yabai -m window --display south || true
shift + alt - k : yabai -m window --warp north || yabai -m window --display north || true
shift + alt - l : yabai -m window --warp east  || yabai -m window --display east  || true

ctrl + alt - h : $HOME/.config/yabai/scripts/resize.sh left
ctrl + alt - j : $HOME/.config/yabai/scripts/resize.sh down
ctrl + alt - k : $HOME/.config/yabai/scripts/resize.sh up
ctrl + alt - l : $HOME/.config/yabai/scripts/resize.sh right

shift + alt - e : yabai -m space --balance

alt - e : yabai -m window --toggle split

alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5

alt - 0x21 : yabai -m space --focus prev || yabai -m space --focus last   # alt + [
alt - 0x1E : yabai -m space --focus next || yabai -m space --focus first  # alt + ]

shift + alt - 1 : yabai -m window --space 1; yabai -m space --focus 1
shift + alt - 2 : yabai -m window --space 2; yabai -m space --focus 2
shift + alt - 3 : yabai -m window --space 3; yabai -m space --focus 3
shift + alt - 4 : yabai -m window --space 4; yabai -m space --focus 4
shift + alt - 5 : yabai -m window --space 5; yabai -m space --focus 5

shift + alt - 0x21 : yabai -m window --space prev; yabai -m space --focus prev
shift + alt - 0x1E : yabai -m window --space next; yabai -m space --focus next

