ctrl + shift + alt - 3 : yabai -m window --display 3; yabai -m display --focus 3

ctrl + shift + alt - p : yabai -m window --display prev; yabai -m display --focus prev
ctrl + shift + alt - n : yabai -m window --display next; yabai -m display --focus next

